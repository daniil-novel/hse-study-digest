# Скопируйте в .env в корне проекта и заполните только нужные поля.
# Все поля секретов ниже пустые. .env должен оставаться только на вашем компьютере.
# Используйте обычный текстовый редактор. Не присылайте заполненный файл в чат.
# Уже заданные переменные окружения ОС имеют приоритет. Новый дочерний сбор перечитает этот файл.

# Собственные данные приложения из my.telegram.org. Это не код входа и не пароль 2FA.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Телефон в международном формате, например +79991234567 (пример не является вашим номером).
# Если он задан, при первом входе MCP не спрашивает номер повторно.
TELEGRAM_PHONE=
# Необязательный пароль двухэтапной проверки Telegram, если вы её включили. Это НЕ одноразовый код.
# Пароль сохраняется буквальным: ${...} не раскрывается, пробелы внутри кавычек сохраняются.
# Для пробелов, # и специальных символов используйте одинарные кавычки, например 'мой пароль'.
# Если пароль не указан, при необходимости MCP спросит его скрытым вводом в вашем терминале.
# Если указанный пароль неверен, исправьте/очистите поле и повторите telegram-login.
TELEGRAM_2FA_PASSWORD=
# Для первого входа нужен одноразовый код из Telegram: введите его только в своём терминале.
# В .env код не записывается. Действующая сохранённая сессия не требует телефона, кода или пароля снова.
# .env — обычный текстовый файл, не зашифрованное хранилище. telegram-login ограничит права доступа.
# Никому не отправляйте его содержимое; пароль 2FA можно удалить после успешного входа.
# ACL и путь хранилища принадлежат штатному MCP. * разрешает выбор среди доступных диалогов.
# Вместо * можно указать точные chat ID через запятую; ПУСТОЙ allowlist запрещает чтение всех чатов.
TELEGRAM_ALLOWED_CHAT_IDS=*
TELEGRAM_DENIED_CHAT_IDS=
TELEGRAM_SESSION_DIR=
# Запись в Telegram в этом практикуме отключена; true не принимается.
TELEGRAM_WRITE_ENABLED=false

# Почта отправляется на ваш собственный адрес. Включение рассылки — отдельно в [mail].
DIGEST_SMTP_ADDRESS=
DIGEST_SMTP_HOST=
DIGEST_SMTP_PORT=
# Пароль приложения SMTP. Обычный пароль аккаунта сюда без указаний провайдера не добавляйте.
DIGEST_SMTP_PASSWORD=

# Необязательный API Smart LMS. Допустим только https://edu.hse.ru.
# Токен выдаёт ВШЭ; наличие учётной записи не означает наличие доступа к API.
LMS_URL=
LMS_TOKEN=
# Совместимость со старой настройкой HSE_LMS_TOKEN: при наличии она имеет приоритет над LMS_TOKEN.
# HSE_LMS_TOKEN=

# Сеансы Telegram, Codex и Claude создаются их командами входа, а не этим файлом.
# Не добавляйте сюда PATH, ключи провайдеров моделей и другие неподдерживаемые настройки.
